# NIET Pharmacy Backend Environment Variables Configuration

# Copy this file to .env.local and set real values before starting the server.
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/NIETPharmacy?retryWrites=true&w=majority
MONGODB_DB_NAME=NIETPharmacy

# Authentication (use a unique random value of at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# Existing upload integration (fill in if uploads are used)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
